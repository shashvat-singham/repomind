# ─────────────────────────────────────────────────────────────────────────────
# RepoMind configuration. Copy to `.env.local` and fill in what you have.
# The app runs with ZERO keys set — it falls back to an in-process Postgres
# (PGlite) and a deterministic local embedding model. Add keys to upgrade
# quality, not to make it boot.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database -----------------------------------------------------------------
# Leave BLANK for local dev / CI: RepoMind spins up PGlite (Postgres compiled to
# wasm, with pgvector) on disk under .repomind-data/. Set this to a Neon
# serverless Postgres URL in production. Must have the `vector` extension.
DATABASE_URL=

# --- Models -------------------------------------------------------------------
# If unset, RepoMind uses a local hash-based embedding + an extractive answerer
# so the whole product is demonstrable offline. Set this to switch to OpenAI
# embeddings (text-embedding-3-small) + a real chat model for generation.
OPENAI_API_KEY=

# Override model ids if you like. These are the defaults.
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# --- Ingestion ----------------------------------------------------------------
# Optional GitHub token — raises the tarball/API rate limit from 60 to 5000/hr
# and allows private repos you have access to. Public repos work without it.
GITHUB_TOKEN=

# --- Guardrails ---------------------------------------------------------------
# Requests per minute per client IP for the chat + ingest endpoints.
RATE_LIMIT_RPM=30

# Optional shared secret to protect the MCP endpoint. If set, MCP clients must
# send `Authorization: Bearer <this>`. Leave blank to keep MCP open (demo mode).
MCP_BEARER_TOKEN=
