# ─────────────────────────────────────────────────────────────────────────────
# RepoMind configuration. Copy to `.env.local` and fill in what you have.
# The app runs with ZERO keys set — it falls back to an in-process Postgres
# (PGlite) and a deterministic local embedding model. Add keys to upgrade
# quality, not to make it boot.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database -----------------------------------------------------------------
# Leave BLANK for local dev / CI: RepoMind spins up PGlite (Postgres compiled to
# wasm, with pgvector) on disk under .repomind-data/. Set this to a Neon
# serverless Postgres URL in production. Must have the `vector` extension.
DATABASE_URL=

# --- Models -------------------------------------------------------------------
# If neither key is set, RepoMind uses a local hash-based embedding + an
# extractive answerer so the whole product is demonstrable offline.
# Provider precedence: OPENAI_API_KEY > GEMINI_API_KEY > local.
OPENAI_API_KEY=

# Override model ids if you like. These are the defaults.
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Google AI Studio key (https://aistudio.google.com/apikey). Used when no OpenAI
# key is present. gemini-embedding-001 is requested at outputDimensionality=1536,
# which keeps the pgvector schema identical across providers.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# NOTE: embeddings from different providers live in different vector spaces, so
# after switching providers every repo must be RE-INDEXED. The app marks
# mismatched repos as "stale index" and refuses to answer from them.

# --- Ingestion ----------------------------------------------------------------
# Optional GitHub token — raises the tarball/API rate limit from 60 to 5000/hr
# and allows private repos you have access to. Public repos work without it.
GITHUB_TOKEN=

# --- Guardrails ---------------------------------------------------------------
# Requests per minute per client IP for the chat + ingest endpoints.
RATE_LIMIT_RPM=30

# Optional shared secret to protect the MCP endpoint. If set, MCP clients must
# send `Authorization: Bearer <this>`. Leave blank to keep MCP open (demo mode).
MCP_BEARER_TOKEN=

# Optional shared secret for the one destructive route, DELETE /api/repos. If
# set, removing an index requires `Authorization: Bearer <this>` — and the in-app
# remove button will get a 401, so set it only on deployments where removal is
# meant to be an operator action. Blank leaves removal open, like the rest of
# this demo's API.
ADMIN_TOKEN=
